# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/src/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database
*.db
prisma/*.db

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

.vercel
src/cookies.txt

.vercel

# AI assistant context files (contain internal dev notes, do not publish)
CLAUDE.md
AGENTS.md
.claude/
.mailmap-cleanup

# 生成图片落盘目录（不入库）
/public/generated/*
!/public/generated/.gitkeep

# 用户上传的参考图（不入库）
/public/uploads/*
!/public/uploads/.gitkeep

# 构建缓存备份（重启 dev 时手动改名产生的）
/.next-bak-*/

# 本地测试产物（截图、脚本、临时输出）
/.shots/
/.test-out/
