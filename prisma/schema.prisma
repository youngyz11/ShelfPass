generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  apiKey          String?
  apiKeyProvider  String           @default("deepseek")
  imageApiKey     String?
  bonusQuota      Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accounts        Account[]
  projects        ProductProject[]
  sessions        Session[]
  analysisRecords AnalysisRecord[]
}

model InviteCode {
  id         String    @id @default(cuid())
  code       String    @unique
  bonusQuota Int       @default(200)
  maxUses    Int       @default(1)
  usedCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@index([code])
}

model AnalysisRecord {
  id           String   @id @default(cuid())
  userId       String
  projectId    String?
  projectName  String?
  analysisType String   // "competitor" | "quality"
  inputData    String   // JSON: competitor input or content checked
  resultData   String   // JSON: full report
  summary      String?  // Short text summary for list display
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, analysisType])
}

model ProductProject {
  id                    String             @id @default(cuid())
  userId                String
  productName           String
  category              String?
  features              String?
  sellingPoints         String?
  keywords              String?
  useScenario           String?
  targetAudience        String?
  priceRange            String?
  brandTone             String?
  platform              String
  language              String

  // Basic product info
  brandName             String?
  material              String?
  specifications        String?
  targetCountry         String?

  // User scenario info
  painPoints            String?
  competitiveAdvantages String?
  festivalScenario      String?

  // Brand & style info
  copyStyle             String?
  bannedWords           String?
  isPromotional         Boolean            @default(false)
  isBrandFocused        Boolean            @default(false)

  // Generation config
  visualStyle           String             @default("minimal")

  /// 视觉事实锚（JSON）：颜色/形态/部件/比例，一次确定后所有图片类型共用，
  /// 避免同一商品被画出不同外观。见 src/lib/visual-spec.ts
  visualSpec            String?

  /// 用户上传的产品参考图（JSON 数组，最多 3 张，如 ["/uploads/xxx.png"]）。
  /// 有值时整组图以它为锚点派生，不再用文生图凭空画产品。
  referenceImages       String?
  generationIntensity   String             @default("balanced")

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  records               GenerationRecord[]
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, platform])
}

model GenerationRecord {
  id          String         @id @default(cuid())
  projectId   String
  contentType String
  content     String?
  imageUrl    String?
  prompt      String?
  favorited   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  project     ProductProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, contentType])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([favorited])
}
